    {
      "@type": "Action",
      "@id": "urn:voltron:mission:verify-and-release-multi-cli-agent-formation-v1:assignment:1",
      "name": "Environment recon",
      "description": "Inventory every CLI on this machine (claude, opencode, agy, codex) with version, auth state and its non-interactive mode (claude -p, opencode run, agy -p, codex exec); confirm openshell is NOT on PATH; confirm the Context7 MCP connects in each CLI (claude mcp list, opencode mcp list, codex mcp list, agy plugin list); recon from ./graphify-out/ built by Black's Step 0 preflight; record the latest CI run on main and which PLAN.md items are still open.",
      "agent": {
        "@id": "urn:voltron:lion:green"
      },
      "object": [],
      "actionStatus": "https://schema.org/CompletedActionStatus",
      "result": {
        "@type": "DefinedTerm",
        "name": "result",
        "description": "Recon table delivered: Claude Code 2.1.310, OpenCode 2.1.4 (upgraded mid-session from 1.19.4), Antigravity CLI 1.4.7, Codex CLI 0.164.0 (standalone, signed in), openshell absent, Context7 connected. It surfaced the OpenCode 2.x plugin-API break, confirmed independently by live runs."
      }
    },
    {
      "@type": "Action",
      "@id": "urn:voltron:mission:verify-and-release-multi-cli-agent-formation-v1:assignment:2",
      "name": "Codex CLI bring-up and adapter verification",
      "description": "Install Codex CLI (user runs `codex login`), install dist/codex into a scratch repo, trust hooks via /hooks, and resolve the four UNVERIFIED items in docs/capability-matrix.md: hyphenated agent names, commandWindows quoting on Windows, exec_command payload shape, plugin-vs-project hooks. Patch the Codex adapter only; build to a temp dir with --out to test.",
      "agent": {
        "@id": "urn:voltron:lion:blue"
      },
      "object": [
        {
          "@id": "urn:voltron:file:adapters/codex/adapter.py"
        },
        {
          "@id": "urn:voltron:file:adapters/codex/hooks.json"
        },
        {
          "@id": "urn:voltron:file:adapters/codex/actionboard.rules"
        }
      ],
      "actionStatus": "https://schema.org/ActiveActionStatus",
      "result": {
        "@type": "DefinedTerm",
        "name": "result",
        "description": "Codex 0.164.0 ran the whole mission end to end: $start-mission, spawn_agent with hyphenated agent names, Context7 from config.toml, offline graph, maturity summary. Outstanding: the guard hook's live denial on Codex was not observed, because project hooks need a one-time /hooks trust in the interactive TUI."
      },
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "dependsOn",
          "value": "urn:voltron:mission:verify-and-release-multi-cli-agent-formation-v1:assignment:1"
        }
      ]
    },
    {
      "@type": "Action",
      "@id": "urn:voltron:mission:verify-and-release-multi-cli-agent-formation-v1:assignment:3",
      "name": "Live smoke round 1 (Claude Code, OpenCode, Antigravity)",
      "description": "Run smoke tests 4.3, 4.4 (parity vs v0.6.1), 5.8 and 7.6 from tests/smoke/README.md in throwaway repos with the stub openshell first on PATH. Objective: add a /hello endpoint. Check the four-part report, the go/no-go stop, Green running as a separate agent, the / menu entries (/mission-brief, /mission-plan, ...), guard deny/ask behaviour, and the cost layer: preflight asks both opt-in questions with their notes and records .actionboard/preferences.json, Context7 answers, Green recon is graph-backed, and with terse output on the brief/plan/report stay in full prose and every Agent report ends with Files created/changed, and each completed mission scores its assignments into .actionboard/registry.json and shows the Maturity & Progress Summary. Record failures; do not fix them.",
      "agent": {
        "@id": "urn:voltron:lion:yellow"
      },
      "object": [
        {
          "@id": "urn:voltron:file:tests/smoke/results-2026-10.md"
        },
        {
          "@id": "urn:voltron:file:tests/smoke/stub/openshell"
        }
      ],
      "actionStatus": "https://schema.org/CompletedActionStatus",
      "result": {
        "@type": "DefinedTerm",
        "name": "result",
        "description": "Round 1 passed on all four CLIs after six defect fixes; results in tests/smoke/results-2026-10.md. Tests were re-run independently in every project."
      },
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "dependsOn",
          "value": "urn:voltron:mission:verify-and-release-multi-cli-agent-formation-v1:assignment:1"
        }
      ]
    },
