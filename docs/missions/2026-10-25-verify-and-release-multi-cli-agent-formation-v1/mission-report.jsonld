    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:verify-and-release-multi-cli-agent-formation-v1:risk:1",
      "additionalType": "Risk",
      "name": "A guard regression lets a smoke test run a real destructive openshell command",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "data-loss"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "H"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "openshell is not installed here; smoke runs put a stub openshell (echo only) first on PATH and assert it was never reached for denied commands"
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:verify-and-release-multi-cli-agent-formation-v1:risk:2",
      "additionalType": "Risk",
      "name": "Terse output leaks into mission briefs, plans, reports, code, commits or security reviews",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "scope"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "H"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Full-prose rule in the three document skills, in every agent's operating policy and in terse-output itself; build tests assert the rule ships to every CLI; smoke round checks the documents with terse output on"
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:verify-and-release-multi-cli-agent-formation-v1:risk:3",
      "additionalType": "Risk",
      "name": "Hosted Context7 server is rate limited or unreachable, and preflight stops every mission",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "integration"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "M"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Preflight states the failure and the fix in full sentences; optional CONTEXT7_API_KEY raises limits; a user-configured context7 server (local or keyed) is detected and left untouched"
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:verify-and-release-multi-cli-agent-formation-v1:risk:4",
      "additionalType": "Risk",
      "name": "Installing Graphify changes the user's Python environment",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "data-loss"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "L"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Asked first with an explanatory note; isolated installers preferred (uv tool, then pipx); version pinned; graphify install/hook commands that edit global CLI config are never run"
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:verify-and-release-multi-cli-agent-formation-v1:risk:5",
      "additionalType": "Risk",
      "name": "Self-scoring inflates maturity, so actions reach Autonomous without real evidence",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "scope"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "H"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Unscored stage = fail; retry-to-green fails the Action stage; Action passes only when someone other than the doing Agent verified it; numbers only from maturity.py (gate rules, 20-run window, 90 days); operator level is never raised by a mission; the committed registry makes every score reviewable in a diff"
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:verify-and-release-multi-cli-agent-formation-v1:risk:6",
      "additionalType": "Risk",
      "name": "Parallel missions conflict on .actionboard/registry.json",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "integration"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "L"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Runs are append-only with unique run ids; resolve by keeping both runs; split per action if it recurs"
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:verify-and-release-multi-cli-agent-formation-v1:risk:7",
      "additionalType": "Risk",
      "name": "Claude Code subagents cannot dispatch subagents, so Black-as-subagent never runs Green",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "technical"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "H"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Smoke 4.3 answers it first; fallback is the session-plays-Black branch already used on the other CLIs"
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:verify-and-release-multi-cli-agent-formation-v1:risk:8",
      "additionalType": "Risk",
      "name": "Codex assumptions are wrong (hyphenated names, Windows hook quoting, exec_command payload)",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "integration"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "H"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Blue verifies each item live before Red cuts the RC; x-codex name overrides and commandWindows tweaks are adapter-only changes"
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:verify-and-release-multi-cli-agent-formation-v1:risk:9",
      "additionalType": "Risk",
      "name": "Antigravity workspace plugin loads but the hook 'allow' result auto-approves commands",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "integration"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "M"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Smoke 7.6 checks a harmless command still prompts per normal agy permissions; if not, emit {} instead of allow"
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:verify-and-release-multi-cli-agent-formation-v1:risk:10",
      "additionalType": "Risk",
      "name": "Model nondeterminism makes smoke results flaky",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "technical"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "M"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Fixed objective, throwaway repo, record CLI + model version; a step fails only if it fails twice"
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:verify-and-release-multi-cli-agent-formation-v1:risk:11",
      "additionalType": "Risk",
      "name": "Private repo blocks marketplace / agy installs from GitHub on other machines",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "integration"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "M"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Smoke from the local clone; flipping to public is a user decision at release"
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:verify-and-release-multi-cli-agent-formation-v1:risk:12",
      "additionalType": "Risk",
      "name": "Optional work creeps in (npx/uvx package, default non-Anthropic model maps, new CLIs)",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "scope"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "M"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Out of scope for this mission; logged as follow-ups in the report"
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:verify-and-release-multi-cli-agent-formation-v1:risk:13",
      "additionalType": "Risk",
      "name": "Installer or smoke runs edit a real project's AGENTS.md or .codex/hooks.json",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "data-loss"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "L"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Throwaway repos only; installer refuses foreign files and uninstall is manifest-tracked"
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:verify-and-release-multi-cli-agent-formation-v1:risk:14",
      "additionalType": "Risk",
      "name": "CLI updates change formats between test and release",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "technical"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "L"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Pin tested versions in README; golden/dist drift check in CI catches build-side drift"
        }
      ]
    },
