    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:zero-footprint-installer-npx-zero-clone-v1-1-0:risk:1",
      "additionalType": "Risk",
      "name": "--cleanup deletes a directory that is not the throwaway clone, such as a developer checkout or the user's own project",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "data-loss"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "H"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Delete only a strict subdirectory of --project that is a git work tree with the expected origin; refuse when the path equals or contains the project; tests cover every refusal."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:zero-footprint-installer-npx-zero-clone-v1-1-0:risk:2",
      "additionalType": "Risk",
      "name": "Cleanup removes a clone holding local edits or the user's agentformation.config.json",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "data-loss"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "M"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Refuse when `git status --porcelain` is non-empty or --config resolves inside the clone; print why and leave the clone."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:zero-footprint-installer-npx-zero-clone-v1-1-0:risk:3",
      "additionalType": "Risk",
      "name": "rmtree fails on Windows because .git object files are read-only, leaving a half-deleted clone",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "technical"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "M"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Use an onerror handler that clears the read-only bit and retries; on any remaining failure print the path and exit 0 since the install itself succeeded."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:zero-footprint-installer-npx-zero-clone-v1-1-0:risk:4",
      "additionalType": "Risk",
      "name": "The @actionboard npm scope is not owned, so `npx @actionboard/install` cannot be published as named",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "integration"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "H"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "User registers the scope or chooses another name before publishing; fallback is `npx <release .tgz URL>` attached to the GitHub release; the README states which command is live."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:zero-footprint-installer-npx-zero-clone-v1-1-0:risk:5",
      "additionalType": "Risk",
      "name": "No git tags or releases exist, so the wrapper's download returns 404 until v1.1.0 is tagged",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "integration"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "H"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Wrapper reports a clear error naming the missing tag; ACTIONBOARD_BUNDLE override for tests and smoke; tag and release are a listed user step."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:zero-footprint-installer-npx-zero-clone-v1-1-0:risk:6",
      "additionalType": "Risk",
      "name": "npx users without Python 3.9+ cannot run the wrapper, since it delegates to scripts/install.py",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "technical"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "M"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Wrapper detects python3, python and py -3 and exits with an install hint; accept the dependency rather than porting the installer to Node this mission."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:zero-footprint-installer-npx-zero-clone-v1-1-0:risk:7",
      "additionalType": "Risk",
      "name": "Tarball extraction allows path traversal or differs across platforms",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "technical"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "M"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Extract with Python tarfile using the 'data' filter, available on every supported Python patch release; Yellow security-reviews."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:zero-footprint-installer-npx-zero-clone-v1-1-0:risk:8",
      "additionalType": "Risk",
      "name": "Remote code is downloaded and executed without integrity checks",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "integration"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "M"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Pin the download to the wrapper's own version tag over HTTPS; accept and monitor for 1.1.0, with a SHA-256 manifest proposed for the next release."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:zero-footprint-installer-npx-zero-clone-v1-1-0:risk:9",
      "additionalType": "Risk",
      "name": "Existing users who keep a clone for updates see changed behaviour",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "integration"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "M"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "--cleanup is opt-in and only the new one-liner passes it; old commands behave as in 1.0.0; a regression test asserts identical output without the flag."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:zero-footprint-installer-npx-zero-clone-v1-1-0:risk:10",
      "additionalType": "Risk",
      "name": "Projects installed with 1.0.0 have no standalone uninstaller once their clone is deleted",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "data-loss"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "L"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "The manifest location is unchanged, so `npx @actionboard/install --uninstall` and a fresh clone both still uninstall them; documented in the README."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:zero-footprint-installer-npx-zero-clone-v1-1-0:risk:11",
      "additionalType": "Risk",
      "name": "The temp directory is left behind when the wrapper is interrupted",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "technical"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "L"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Remove it in a finally block and on SIGINT; temp dirs live under os.tmpdir(), which the OS reclaims."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:zero-footprint-installer-npx-zero-clone-v1-1-0:risk:12",
      "additionalType": "Risk",
      "name": "PyPI publishing, a Node port of the installer, and signed bundles creep into this mission",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "scope"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "M"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Out of scope: uvx runs from the git subdirectory, the installer stays Python, signing is deferred."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:zero-footprint-installer-npx-zero-clone-v1-1-0:risk:13",
      "additionalType": "Risk",
      "name": "The registry is credited with an autonomous-mode unlock the run history does not support",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "scope"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "L"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Maturity comes from the scored run history in the report, never asserted in advance."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:zero-footprint-installer-npx-zero-clone-v1-1-0:risk:14",
      "additionalType": "Risk",
      "name": "Live smoke runs fail on CLI authentication or cost more tokens than expected",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "technical"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "L"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Green confirms auth first; one short prompt per CLI; failures are recorded, not retried in a loop."
        }
      ]
    },
    {
