    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:criterion:1",
      "name": "Every new GraphQL document is valid against the live schema. graphql.validate() ",
      "description": "Every new GraphQL document is valid against the live schema. graphql.validate() from graphql-core 3.2.6, the version CI pins, returns zero errors for each new QUERY_* and MUTATION_* constant when checked against the captured schema.json. Checked by Yellow Agent.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:success-criteria"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:criterion:2",
      "name": "The build is clean and every suite passes. python3 scripts/build.py --check exit",
      "description": "The build is clean and every suite passes. python3 scripts/build.py --check exits 0, and the guard, build, install, maturity, report, and installer unittest suites each report OK, including the new tests/report/test_pod_services.py. Checked by Yellow Agent with exact counts, and re-run by Black Agent.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:success-criteria"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:criterion:3",
      "name": "The CLI surface matches the scope. The --help output of actionlist, action, goal",
      "description": "The CLI surface matches the scope. The --help output of actionlist, action, goal, and files lists every in-scope verb, and a status or priority value outside the schema enum exits with status 2. Checked by Yellow Agent.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:success-criteria"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:criterion:4",
      "name": "The live round trip works on the board \"Actionboard Mission Board\". Using --no-i",
      "description": "The live round trip works on the board \"Actionboard Mission Board\". Using --no-input --json, the CLI creates an ActionList, adds an action item, moves the item from New to In_Progress to Done, moves the list to Done, creates a goal and moves it from PENDING to IN_PROGRESS to COMPLETED, uploads a file and downloads it again with an identical SHA-256 digest, and each read-back shows the new status. Every record it created is then deleted and a final listing shows none remain. Checked by Yellow Agent's live smoke test.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:success-criteria"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:criterion:5",
      "name": "No secret leaks. No access token, refresh token, password, or Authorization head",
      "description": "No secret leaks. No access token, refresh token, password, or Authorization header value appears in command output, --json output, error messages, or test fixtures. Checked by Yellow Agent's security review and a search of the captured outputs.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:success-criteria"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:criterion:6",
      "name": "Downloads cannot escape their directory. A server-supplied file name such as ../",
      "description": "Downloads cannot escape their directory. A server-supplied file name such as ../../evil is written inside the chosen output directory or refused. Checked by a unit test.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:success-criteria"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:criterion:7",
      "name": "Deletes are never silent. Under --no-input and without --yes, every delete comma",
      "description": "Deletes are never silent. Under --no-input and without --yes, every delete command exits non-zero and sends no delete mutation. Checked by a unit test that counts delete calls.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:success-criteria"
      }
    },
