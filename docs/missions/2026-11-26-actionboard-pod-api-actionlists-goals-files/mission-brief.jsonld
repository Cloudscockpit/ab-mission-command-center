      "name": "The CLI talks GraphQL through the edge proxy and reuses the existing pod-token p",
      "description": "The CLI talks GraphQL through the edge proxy and reuses the existing pod-token path (_resolve_pod_token_and_profile); no new runtime dependency is added, and the code stays Python 3.9+ standard library only so it runs on Windows (py), macOS, and Linux.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:constraints"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:constraint:2",
      "name": "src/ is the canonical source and dist/ is regenerated from it by scripts/build.p",
      "description": "src/ is the canonical source and dist/ is regenerated from it by scripts/build.py; nobody edits dist/ by hand.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:constraints"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:constraint:3",
      "name": "Operation, argument, field, and enum names come only from the live schema captur",
      "description": "Operation, argument, field, and enum names come only from the live schema captured on 2026-11-26 in the session scratchpad (schema-introspection/schema.json).",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:constraints"
