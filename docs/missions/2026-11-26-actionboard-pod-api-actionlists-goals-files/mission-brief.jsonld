    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:scope:1",
      "name": "ActionLists (actionlists_*): create; list with a status filter and pagination; s",
      "description": "ActionLists (actionlists_*): create; list with a status filter and pagination; show one by a filtered list lookup, because the schema has no single-get operation; update fields and actionListStatus; delete with confirmation.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:scope"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:scope:2",
      "name": "Action items (actionlists_createAction, getAction, getAllActions, updateAction, ",
      "description": "Action items (actionlists_createAction, getAction, getAllActions, updateAction, deleteAction): create an item in a list; list the items of a list with a status filter; get one by id; update fields and ActionStatus; delete with confirmation.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:scope"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:scope:3",
      "name": "Goals (actiongoals_*): create with title and priority plus optional description,",
      "description": "Goals (actiongoals_*): create with title and priority plus optional description, status, and dates; list by board; get one; update fields including status; delete with confirmation.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:scope"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:scope:4",
      "name": "File Service (filemanager_*): list folders; create a folder, because an upload n",
      "description": "File Service (filemanager_*): list folders; create a folder, because an upload needs a folderId; list the files in a folder; upload a local file through the edge presign route and filemanager_createFile; download a file by id into a local directory; delete a file with confirmation.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:scope"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:scope:5",
      "name": "Four new subcommand groups on the existing submit_mission.py CLI, actionlist, ac",
      "description": "Four new subcommand groups on the existing submit_mission.py CLI, actionlist, action, goal, and files, which default the Pod and Board to .actionboard/config.json, accept a --board override, and support --json and --no-input.",
