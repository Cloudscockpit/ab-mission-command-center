    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:constraint:4",
      "name": "Assumption: ActionList status is actionListStatus and action item status is Acti",
      "description": "Assumption: ActionList status is actionListStatus and action item status is ActionStatus, both using the Actionlists_Status enum (New, Todo, Active, In_Progress, Done, AutoActionAiAgent, ActionAssistAgent); Goal status uses PENDING, IN_PROGRESS, COMPLETED and Goal priority uses LOW, MEDIUM, HIGH.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:constraints"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:constraint:5",
      "name": "Assumption: update mutations may require the record's current _version for AppSy",
      "description": "Assumption: update mutations may require the record's current _version for AppSync conflict detection, so update wrappers read the record first and send it.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:constraints"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:constraint:6",
      "name": "Assumption: the required userId on goal creation comes from the signed-in identi",
      "description": "Assumption: the required userId on goal creation comes from the signed-in identity; Blue Agent confirms which claim and the live smoke test verifies it.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:constraints"
      }
    },
