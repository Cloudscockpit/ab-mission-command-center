      ],
      "result": [
        {
          "@type": "DefinedTerm",
          "name": "acceptance",
          "description": "The --help output of each group lists its verbs. Enum values are enforced and a bad value exits with status 2. The board defaults from .actionboard/config.json and --board overrides it. python3 scripts/build.py --check exits 0 and the existing suites still pass. Verified by Yellow Agent in A3."
        },
        {
          "@type": "DefinedTerm",
          "name": "outcome",
          "description": "Shipped after one fix round: delete --json printed a preamble on stdout (finding 1, Medium) and the control-character filter missed bidi and line-separator characters (finding 3, Low)."
        }
      ],
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "dependsOn",
          "value": "A1"
        }
      ]
    },
    {
      "@type": "Action",
      "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:assignment:3",
      "name": "Write tests/report/test_pod_services.py with a mocked opener, asserting the operation name and variables for every subcommand, plus envelope failure, enum rejection, --json output shape, deletes without --yes, path traversal, and _version on update. Validate every new constant against the captured schema with graphql-core 3.2.6 in a scratchpad virtual environment. Run the build check and all six suites. Run the live smoke test last, with cleanup.",
      "description": "Write tests/report/test_pod_services.py with a mocked opener, asserting the operation name and variables for every subcommand, plus envelope failure, enum rejection, --json output shape, deletes without --yes, path traversal, and _version on update. Validate every new constant against the captured schema with graphql-core 3.2.6 in a scratchpad virtual environment. Run the build check and all six suites. Run the live smoke test last, with cleanup.",
      "agent": {
        "@id": "urn:voltron:lion:yellow"
      },
      "actionStatus": "https://schema.org/CompletedActionStatus",
