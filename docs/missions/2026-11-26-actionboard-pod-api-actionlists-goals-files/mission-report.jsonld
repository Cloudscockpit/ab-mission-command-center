    {
      "@type": "Action",
      "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:assignment:1",
      "name": "Add GraphQL documents for every in-scope ActionList, action item, Goal, and File Service operation, using exact live-schema names, and a service module of wrappers that unwrap the {success, message, data} envelope. Upload and download reuse the existing edge presign, upload, and download helpers.",
      "description": "Add GraphQL documents for every in-scope ActionList, action item, Goal, and File Service operation, using exact live-schema names, and a service module of wrappers that unwrap the {success, message, data} envelope. Upload and download reuse the existing edge presign, upload, and download helpers.",
      "agent": {
        "@id": "urn:voltron:lion:blue"
      },
      "actionStatus": "https://schema.org/CompletedActionStatus",
      "object": [
        {
          "@id": "urn:voltron:file:src/skills/mission-report/scripts/actionboard_cli/operations.py"
        },
        {
          "@id": "urn:voltron:file:src/skills/mission-report/scripts/actionboard_cli/pod_services.py"
        }
      ],
      "result": [
        {
          "@type": "DefinedTerm",
          "name": "acceptance",
          "description": "Every new constant uses only fields present in the captured schema. A success: false response raises RuntimeError carrying the server's message. Update wrappers send the record's _version. Downloads are confined to the output directory. The module docstring lists every public function with its arguments and return shape. Verified by Yellow Agent in A3."
        },
        {
          "@type": "DefinedTerm",
          "name": "outcome",
          "description": "18 new operation constants and a 577-line service module, plus two operator-approved additions: removing the invalid region field from the existing QUERY_MY_PODS, and validating server-supplied bucket names (Yellow Agent finding 2)."
        }
      ]
    },
    {
      "@type": "Action",
      "@id": "urn:voltron:mission:actionboard-pod-api-actionlists-goals-files:assignment:2",
      "name": "Add the actionlist, action, goal, and files subcommand groups, with handlers in a new module that commands.py only registers and dispatches. Status and priority arguments use the schema enums as choices; deletes require --yes under --no-input and an interactive confirmation otherwise. Write the three skills, the documentation, and the registry entry, then regenerate dist/ with python3 scripts/build.py.",
      "description": "Add the actionlist, action, goal, and files subcommand groups, with handlers in a new module that commands.py only registers and dispatches. Status and priority arguments use the schema enums as choices; deletes require --yes under --no-input and an interactive confirmation otherwise. Write the three skills, the documentation, and the registry entry, then regenerate dist/ with python3 scripts/build.py.",
      "agent": {
        "@id": "urn:voltron:lion:red"
      },
      "actionStatus": "https://schema.org/CompletedActionStatus",
      "object": [
        {
          "@id": "urn:voltron:file:src/skills/mission-report/scripts/actionboard_cli/pod_commands.py"
