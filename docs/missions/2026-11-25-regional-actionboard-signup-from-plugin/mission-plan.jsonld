      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:gap:8",
      "name": "Real sign-up in a browser",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "status",
          "value": "use-existing-skill:browser-actions"
        },
        {
          "@type": "PropertyValue",
          "name": "notes",
          "value": "Conditional on per-site approval, and the operator enters any credentials. Not part of this plan."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:risk:1",
      "additionalType": "Risk",
      "name": "A region's accounts live in a different Cognito pool, so a user signs up and then cannot log in through the plugin.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "integration"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "H"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "A1 compares each region with the plugin's defaults before any code is written. If they differ or cannot be established, Black Agent stops and asks the operator."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:risk:2",
      "additionalType": "Risk",
      "name": "A site hides its Cognito settings or blocks the check.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "integration"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "M"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "A1 reports not established instead of guessing, and the operator decides."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:risk:3",
      "additionalType": "Risk",
      "name": "The default names say absaas-dev and the site's social-login callback is a development Lambda in every environment.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "integration"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "H"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Recorded for the operator to confirm before any release."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:risk:4",
      "additionalType": "Risk",
      "name": "A new user may not have an ActionBoard profile or any Pod yet, so Pod selection finds nothing.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "integration"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "M"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "signup ends with a clear no-Pods-yet message instead of an error."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:risk:5",
      "additionalType": "Risk",
      "name": "A stale dist/ fails CI, because CI runs build.py --check.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "integration"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "M"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Only Red Agent writes dist/, and only through build.py; Yellow Agent runs --check."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:risk:6",
      "additionalType": "Risk",
      "name": "After email verification the site ends at its own login page and cannot hand control back to the plugin.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "technical"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "M"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "The plugin starts its own login after sign-up. The site's unvalidated ?redirect= parameter is not used."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:risk:7",
      "additionalType": "Risk",
      "name": "Email verification takes longer than the five-minute login wait.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "technical"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "M"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "The user can run login later to finish signing in, and the command says so."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:risk:8",
      "additionalType": "Risk",
      "name": "A password or verification code reaches the chat, the CLI, or the logs.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "technical"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "H"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "The plugin never calls auth_register; sign-up happens only in the browser, and tests check that no password or code option exists."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:risk:9",
      "additionalType": "Risk",
      "name": "New users have an account but cannot run missions until they have a Pod.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "category",
          "value": "scope"
        },
        {
          "@type": "PropertyValue",
          "name": "severity",
          "value": "M"
        },
        {
          "@type": "PropertyValue",
          "name": "mitigation",
          "value": "Accepted for this mission; the command's final message says so."
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:risk:10",
