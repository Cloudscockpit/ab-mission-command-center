    {
      "@type": "Action",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:assignment:1",
      "name": "A1 Region check using public pages only",
      "description": "Load /auth/signup on https://actionboard.ai and https://actionboard.com.bd and the plugin's /cli login page; request each site's /api/auth/social/Google without following the redirect and compare the Cognito domain and client ID with the plugin's defaults.",
      "agent": {
        "@id": "urn:voltron:lion:blue"
      },
      "actionStatus": "https://schema.org/PotentialActionStatus",
      "result": {
        "@type": "DefinedTerm",
        "name": "acceptance",
        "description": "For each region the report states whether the sign-up page works and whether its accounts are the same as the plugin's, different, or not established, with every request's URL and status code. No saved login is used and no form is submitted."
      }
    },
    {
      "@type": "Action",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:assignment:2",
      "name": "A2 Regional sign-up flow",
      "description": "Add a fixed list of regional sign-up addresses and the sign-up flow: open the chosen region's sign-up page, then run the existing browser login.",
      "agent": {
        "@id": "urn:voltron:lion:blue"
      },
      "actionStatus": "https://schema.org/PotentialActionStatus",
      "result": {
        "@type": "DefinedTerm",
        "name": "acceptance",
        "description": "Sign-up addresses come only from the fixed us/bd list, never from user input. Existing login behaviour and its tests are unchanged. Only regions A1 verified are offered as working."
      },
      "object": [
        {
          "@id": "urn:voltron:file:src/skills/mission-report/scripts/actionboard_cli/auth.py"
        },
        {
          "@id": "urn:voltron:file:src/skills/mission-report/scripts/actionboard_cli/common.py"
        }
      ],
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "dependsOn",
          "value": "urn:voltron:mission:regional-actionboard-signup-from-plugin:assignment:1"
        }
      ]
    },
    {
      "@type": "Action",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:assignment:3",
      "name": "A3 signup command, ab-signup skill, docs and dist",
      "description": "Add the signup command and the ab-signup skill, link it from ab-login, update the docs and changelog, then regenerate dist/ with python3 scripts/build.py.",
      "agent": {
        "@id": "urn:voltron:lion:red"
      },
      "actionStatus": "https://schema.org/PotentialActionStatus",
      "result": {
        "@type": "DefinedTerm",
        "name": "acceptance",
        "description": "In a terminal the command asks for the region; with --no-input it requires --region us or --region bd and otherwise fails with an error naming both. --json output works. It asks before replacing an existing login. python3 scripts/build.py --check passes."
      },
      "object": [
        {
          "@id": "urn:voltron:file:src/skills/mission-report/scripts/actionboard_cli/commands.py"
        },
        {
          "@id": "urn:voltron:file:src/skills/mission-report/scripts/submit_mission.py"
        },
        {
