        },
        {
          "@id": "urn:voltron:file:src/skills/ab-login/SKILL.md"
        },
        {
          "@id": "urn:voltron:file:src/skills/submit-mission/references/cli-reference.md"
        },
        {
          "@id": "urn:voltron:file:README.md"
        },
        {
          "@id": "urn:voltron:file:CHANGELOG.md"
        },
        {
          "@id": "urn:voltron:file:dist/"
        }
      ],
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "dependsOn",
          "value": "urn:voltron:mission:regional-actionboard-signup-from-plugin:assignment:2"
        }
      ]
    },
    {
      "@type": "Action",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:assignment:4",
      "name": "A4 Tests and security review",
      "description": "Write the tests, run every suite, and review the change for security.",
      "agent": {
        "@id": "urn:voltron:lion:yellow"
      },
      "actionStatus": "https://schema.org/PotentialActionStatus",
      "result": {
        "@type": "DefinedTerm",
        "name": "acceptance",
        "description": "Tests cover both regions, a missing region, an invalid region, a timeout, a bad nonce, and a declined replacement of an existing login. The report gives the exact test command and pass/fail counts, and security findings rated by severity."
      },
      "object": [
        {
          "@id": "urn:voltron:file:tests/report/test_signup.py"
        },
        {
          "@id": "urn:voltron:file:tests/report/test_browser_login.py"
        }
      ],
      "additionalProperty": [
