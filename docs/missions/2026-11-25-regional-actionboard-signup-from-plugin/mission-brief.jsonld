      "name": "After the user has signed up and verified their email, the command runs the existing brows",
      "description": "After the user has signed up and verified their email, the command runs the existing browser login so the user ends signed in, with tokens stored exactly as login stores them.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:scope"
      }
    },
