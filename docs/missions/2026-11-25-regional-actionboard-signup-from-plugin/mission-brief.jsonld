      "@type": "Project",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin",
      "name": "Regional ActionBoard sign-up from the plugin",
      "description": "Let a person with no ActionBoard account choose a region, sign up on that region's ActionBoard site from the Claude plugin, and end up signed in to the plugin.",
      "identifier": "regional-actionboard-signup-from-plugin",
      "startDate": "2026-11-25",
      "subjectOf": {
        "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:brief"
      }
    },
