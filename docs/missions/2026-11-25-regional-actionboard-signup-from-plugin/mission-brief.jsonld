    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:scope:1",
      "name": "A signup command in the ActionBoard CLI that takes a region choice, us (https://actionboar",
      "description": "A signup command in the ActionBoard CLI that takes a region choice, us (https://actionboard.ai) or bd (https://actionboard.com.bd), and opens that site's /auth/signup page in the user's browser.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:scope"
