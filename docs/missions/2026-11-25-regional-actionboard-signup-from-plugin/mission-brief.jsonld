    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:criterion:1",
      "name": "The region is always the user's choice",
      "description": "With --no-input and no --region, the command exits with a non-zero status and an error that names us and bd. Checked by a unit test.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:success-criteria"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:criterion:2",
      "name": "The right page opens and the user ends signed in",
      "description": "signup --region us opens exactly https://actionboard.ai/auth/signup and signup --region bd opens exactly https://actionboard.com.bd/auth/signup; the command then completes the existing login against a mocked server and stores the tokens. Checked by unit tests with a mocked browser and a mocked HTTP opener.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:success-criteria"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:criterion:3",
      "name": "No password or verification code passes through the plugin",
      "description": "The signup command has no password or code option and never prompts for either. Checked by a unit test and by Yellow Agent's security review.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:success-criteria"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:criterion:4",
      "name": "A region the plugin cannot log in to is not presented as working",
      "description": "The command's behaviour per region matches Blue Agent's A1 verdict on whether that region's accounts are the ones the plugin logs in to. Checked by Yellow Agent against the A1 evidence.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:success-criteria"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:criterion:5",
      "name": "The build stays clean",
      "description": "Every test suite passes and python3 scripts/build.py --check reports no drift. Checked by Yellow Agent running both commands and reporting the exact counts.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:success-criteria"
      }
    },
