      "name": "A4 Tests and security review",
      "description": "Write the tests, run every suite, and review the change for security.",
      "agent": {
        "@id": "urn:voltron:lion:yellow"
      },
      "actionStatus": "https://schema.org/CompletedActionStatus",
      "result": {
        "@type": "DefinedTerm",
        "name": "outcome",
        "description": "34 new tests in tests/report/test_signup.py; security review with two Medium and three Low findings, four fixed and one accepted. Final run: guard 32 OK, build 23 OK, install 55 OK (1 skipped), maturity 18 OK, report 220 OK (1 skipped), installer 23 OK; build.py --check clean. Re-run by Black Agent with identical results."
      },
      "object": [
