    {
      "@type": "Action",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:assignment:1",
      "name": "A1 Region check using public pages only",
      "description": "Load /auth/signup on https://actionboard.ai and https://actionboard.com.bd and the plugin's /cli login page; request each site's /api/auth/social/Google without following the redirect and compare the Cognito domain and client ID with the plugin's defaults.",
      "agent": {
        "@id": "urn:voltron:lion:blue"
      },
      "actionStatus": "https://schema.org/CompletedActionStatus",
      "result": {
        "@type": "DefinedTerm",
        "name": "outcome",
        "description": "BD sign-ups create accounts in the plugin's Cognito pool (absaas-dev, ap-southeast-1, same client ID and callback); US not established because actionboard.ai returned an HTML shell instead of a Cognito redirect. Independently reproduced by Yellow Agent. Blue's report misquoted the client ID suffix (0070; actual ir70); the verdict was correct."
      },
      "endTime": "2026-11-26T15:35:50Z"
    },
    {
      "@type": "Action",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:assignment:2",
      "name": "A2 Regional sign-up flow",
      "description": "Add a fixed list of regional sign-up addresses and the sign-up flow: open the chosen region's sign-up page, then run the existing browser login.",
      "agent": {
        "@id": "urn:voltron:lion:blue"
      },
      "actionStatus": "https://schema.org/CompletedActionStatus",
      "result": {
        "@type": "DefinedTerm",
        "name": "outcome",
        "description": "Added SIGNUP_REGIONS and SIGNUP_REGION_CHOICES to common.py, and signup_url, SignupRegionPending, _signup_region and open_signup_page to auth.py. Existing login unchanged. One rework round (A2b): browser catch widened to (webbrowser.Error, OSError) and spacing fixed."
      },
      "object": [
        {
          "@id": "urn:voltron:file:src/skills/mission-report/scripts/actionboard_cli/auth.py"
        },
        {
          "@id": "urn:voltron:file:src/skills/mission-report/scripts/actionboard_cli/common.py"
        }
      ],
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "dependsOn",
          "value": "urn:voltron:mission:regional-actionboard-signup-from-plugin:assignment:1"
        }
