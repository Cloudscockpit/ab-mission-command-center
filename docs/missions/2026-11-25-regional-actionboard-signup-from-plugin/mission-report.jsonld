    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:criterion:2",
      "name": "The right page opens and the user ends signed in",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:success-criteria"
      },
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "status",
          "value": "partly met"
        },
        {
          "@type": "PropertyValue",
          "name": "evidence",
          "value": "Met for bd: the browser opens exactly https://actionboard.com.bd/auth/signup and the shared _browser_login is called once. The us half was superseded by the operator's decision: us opens nothing and reports region_pending with the exact US URL. No real sign-up performed."
        }
      ]
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:criterion:3",
      "name": "No password or verification code passes through the plugin",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:success-criteria"
      },
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "status",
          "value": "met"
        },
        {
          "@type": "PropertyValue",
          "name": "evidence",
          "value": "Parser-introspection test finds no password, code, email, url or host option; security review found no path that accepts, prompts for, logs or echoes either."
        }
      ]
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:criterion:4",
