    },
    {
      "@type": "Action",
      "@id": "urn:voltron:mission:regional-actionboard-signup-from-plugin:assignment:3",
      "name": "A3 signup command, ab-signup skill, docs and dist",
      "description": "Add the signup command and the ab-signup skill, link it from ab-login, update the docs and changelog, then regenerate dist/ with python3 scripts/build.py.",
      "agent": {
        "@id": "urn:voltron:lion:red"
      },
      "actionStatus": "https://schema.org/CompletedActionStatus",
      "result": {
        "@type": "DefinedTerm",
        "name": "outcome",
        "description": "Added the signup command and cmd_signup, a shared _browser_login helper with unchanged cmd_login behaviour, the ab-signup skill, ab-login pointer, CLI reference, README and CHANGELOG (Unreleased, no version bump), and regenerated dist/. Re-plan A3b added two docs (black-agent.md, submit-mission SKILL.md). Fix round A3c guarded the region and replace-session prompts against EOF and Ctrl+C."
      },
      "object": [
