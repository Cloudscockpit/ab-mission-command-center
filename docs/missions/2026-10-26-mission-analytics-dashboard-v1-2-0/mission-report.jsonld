    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:mission-analytics-dashboard-v1-2-0:criterion:1",
      "name": "mission-report.html is generated automatically on every /start-mission across all CLIs",
      "description": "Wired into mission-report SKILL step 8 and Black Agent; both scripts byte-identical in all four dist targets; documented commands ran end to end from a built target. Not yet run live on OpenCode, Codex or Antigravity.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:mission-analytics-dashboard-v1-2-0:success-criteria"
      },
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "met",
          "value": "Partly"
        }
      ]
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:mission-analytics-dashboard-v1-2-0:criterion:2",
      "name": "Hallmark anti-slop standard applied: #0a0c10 background, 1px rgba(255,255,255,0.08) borders, no gradients, high density",
      "description": "Token and Floor tests pass; sloplint 0 FAIL, 0 REJECTED, one waived finding (gate 72); screenshots read as images.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:mission-analytics-dashboard-v1-2-0:success-criteria"
      },
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "met",
          "value": "Met"
        }
      ]
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:mission-analytics-dashboard-v1-2-0:criterion:3",
      "name": "Inter or system font for UI and Geist Mono or JetBrains Mono for numbers and paths",
      "description": "Declared as font stacks with system fallbacks; font files are not embedded.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:mission-analytics-dashboard-v1-2-0:success-criteria"
      },
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "met",
          "value": "Partly"
        }
      ]
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:mission-analytics-dashboard-v1-2-0:criterion:4",
      "name": "Single file, inline CSS and JS, zero external requests, inline SVG donut and progress bars",
      "description": "Network grep 0; CSP with hash-pinned inline script and style; Black puppeteer run 0 non-file requests, 0 console messages at four widths.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:mission-analytics-dashboard-v1-2-0:success-criteria"
      },
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "met",
          "value": "Met"
        }
      ]
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:mission-analytics-dashboard-v1-2-0:criterion:5",
      "name": "Mobile-first from 375px to 4K",
      "description": "No horizontal scroll at 375, 768, 1440, 3840; all tap targets at least 44px at 375; content capped near 1360px.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:mission-analytics-dashboard-v1-2-0:success-criteria"
      },
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "met",
          "value": "Met"
        }
      ]
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:mission-analytics-dashboard-v1-2-0:criterion:6",
      "name": "Dashboard components: header and status, four KPIs, Agent workload, five-stage maturity, file accordion with path copy",
      "description": "All present in static markup; copy returns the exact path under file://; badge is sentence case.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:mission-analytics-dashboard-v1-2-0:success-criteria"
      },
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "met",
          "value": "Met"
        }
      ]
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:mission-analytics-dashboard-v1-2-0:criterion:7",
      "name": "Unit tests in tests/report verify zero network requests and HTML validity",
      "description": "126 tests re-run by Black on Python 3.14 and 3.9.25; six required mutations turn the suite red.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:mission-analytics-dashboard-v1-2-0:success-criteria"
      },
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "met",
          "value": "Met"
        }
      ]
    },
    {
      "@type": "DefinedTerm",
      "@id": "urn:voltron:mission:mission-analytics-dashboard-v1-2-0:criterion:8",
      "name": "src/VERSION is 1.2.0, dist/ regenerated, README has a dashboard preview",
      "description": "build.py --check prints dist/ is up to date; every manifest and package reads 1.2.0; README section with desktop and mobile previews. CI on GitHub has not run.",
      "inDefinedTermSet": {
        "@id": "urn:voltron:mission:mission-analytics-dashboard-v1-2-0:success-criteria"
      },
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "met",
          "value": "Met"
        }
      ]
    },
